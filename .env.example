# Equilibrium — variáveis públicas do cliente (não commitar .env)

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Nunca colocar no frontend:
# SUPABASE_SERVICE_ROLE_KEY=
# OCR_SPACE_API_KEY=   # secret da Edge Function parse-receipt
# OPENAI_API_KEY=      # secret da Edge Function controlinho-chat
# OPENAI_MODEL=gpt-4o-mini
# PRICE_SEARCH_API_KEY= # secret opcional da Edge external-search
# EXTERNAL_SEARCH_ENABLED=true

# Flags públicas (opcional)
# EXPO_PUBLIC_EXTERNAL_SEARCH_ENABLED=true
# EXPO_PUBLIC_LOCATION_FEATURES_ENABLED=true
# EXPO_PUBLIC_PROMOTIONS_ENABLED=true
